# ============================================================
# Variables de entorno - Auditoria Continua ISO 27001 (ISO-4)
# Copia este archivo a ".env" y completa los valores reales.
# El .env real NUNCA se sube al repo (va en .gitignore).
# ============================================================

# Credenciales de la base PostgreSQL (las usa docker-compose)
POSTGRES_USER=auditor
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=iso27001
POSTGRES_PORT=5432

# Cadena de conexion para el generador y el motor (Python)
DATABASE_URL=postgresql://auditor:cambia_esta_clave@localhost:5432/iso27001
